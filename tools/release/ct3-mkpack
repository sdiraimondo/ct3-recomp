#!/bin/sh
# Génère le pack de données CT3 depuis la copie de l'utilisateur.
# Usage : bin/ct3-mkpack /chemin/vers/CT3.exe [dossier_de_sortie]
# Le SHA-256 attendu est celui du CT3.exe qui a servi à construire ce bundle :
# un autre binaire est refusé (les constantes du pack sont compilées dans le
# runtime).
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)

exe=${1:-${CT3_EXE:-}}
if [ -z "$exe" ]; then
    echo "usage : $0 /chemin/vers/CT3.exe [dossier_de_sortie]" >&2
    exit 2
fi
if [ ! -f "$exe" ]; then
    echo "ct3-mkpack : fichier introuvable : $exe" >&2
    exit 2
fi

out=${2:-"$root/share/ct3/pack"}
expected=$(cat "$root/share/ct3/EXPECTED_SHA256")
mkdir -p "$out"

python3 "$root/share/ct3/pepack.py" "$exe" "$out" --expect-sha256 "$expected"

echo "pack généré : $out"
