diff --git a/meson.build b/meson.build
index d10f07d..b08f40a 100644
--- a/meson.build
+++ b/meson.build
@@ -158,6 +158,8 @@ else
     './include/native/directx'
   ]
 
+  enable_switch = get_option('native_switch')
+
   lib_sdl3 = dependency('sdl3', required: get_option('native_sdl3'))
   lib_sdl2 = dependency('sdl2', required: get_option('native_sdl2'))
   lib_glfw = dependency('glfw3', required: get_option('native_glfw'))
@@ -170,8 +172,11 @@ else
   if lib_glfw.found()
     compiler_args += ['-DDXVK_WSI_GLFW']
   endif
-  if (not lib_sdl3.found() and not lib_sdl2.found() and not lib_glfw.found())
-    error('SDL3, SDL2, or GLFW are required to build dxvk-native')
+  if enable_switch
+    compiler_args += ['-DDXVK_WSI_SWITCH']
+  endif
+  if (not lib_sdl3.found() and not lib_sdl2.found() and not lib_glfw.found() and not enable_switch)
+    error('SDL3, SDL2, GLFW, or native_switch are required to build dxvk-native')
   endif
   
   dxvk_name_prefix = 'dxvk_'
diff --git a/meson_options.txt b/meson_options.txt
index 98851af..02cc047 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -7,3 +7,4 @@ option('build_id',     type : 'boolean', value : false)
 option('native_glfw',  type : 'feature', value : 'auto', description: 'Enable GLFW WSI for DXVK Native')
 option('native_sdl2',  type : 'feature', value : 'auto', description: 'Enable SDL2 WSI for DXVK Native')
 option('native_sdl3',  type : 'feature', value : 'auto', description: 'Enable SDL3 WSI for DXVK Native')
+option('native_switch', type : 'boolean', value : false, description: 'Enable Nintendo Switch (Horizon/libnx, VK_NN_vi_surface) WSI for DXVK Native')
diff --git a/src/wsi/meson.build b/src/wsi/meson.build
